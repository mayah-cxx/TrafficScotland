<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <TextView
        android:id="@+id/txtSearchTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Search Traffic Events"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#172B4D"
        android:padding="20dp"
        android:background="#FFFFFF" />

    <EditText
        android:id="@+id/edtSearchRoad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:hint="Enter a road name (e.g. M8)"
        android:inputType="text"
        android:singleLine="true"
        android:padding="14dp"
        android:background="#FFFFFF" />

    <TextView
        android:id="@+id/txtSearchEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter a road name to search traffic events."
        android:textSize="16sp"
        android:textColor="#666666"
        android:gravity="center"
        android:padding="20dp" />

    <ListView
        android:id="@+id/listSearchResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#DDDDDD"
        android:dividerHeight="1dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:visibility="gone" />

</LinearLayout>
